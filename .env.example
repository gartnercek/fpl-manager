# Copy to .env for local wrangler. Never commit real keys.
# Cloudflare Pages: Settings → Environment variables (Production).
# GitHub Actions: Settings → Secrets and variables → Actions.

# Stripe (same live key on Cloudflare; a restricted read key is enough on GitHub)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEASON=
STRIPE_PRICE_MONTHLY=
# Live catalog (use only with a live secret, after identity is complete):
# STRIPE_PRICE_SEASON=price_1U8LadAoVac84U9I7uAnpzCN
# STRIPE_PRICE_MONTHLY=price_1U8LaeAoVac84U9Iqu9PhUoC
STRIPE_SEASON=2026/27
STRIPE_AUTOMATIC_TAX=0
SITE_ORIGIN=https://fpl-manager.com

# Mailer (already used by fpl-weekly)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_REPLY_TO=
EMAIL_OPERATOR=

# Optional JSON list if someone pays outside Stripe
# SUBSCRIBERS_JSON=[{"team_id":123,"email":"a@b.co","plan":"season"}]
# BILLING_BLOCKLIST=123,456
